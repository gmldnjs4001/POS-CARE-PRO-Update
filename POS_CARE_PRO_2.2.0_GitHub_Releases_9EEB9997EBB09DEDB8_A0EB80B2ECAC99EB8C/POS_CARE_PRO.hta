<style>
html,body{margin:0;padding:0;width:100%;height:100%;overflow:hidden;background:#071426;color:#dce8f7;font-family:"Malgun Gothic","맑은 고딕",Arial,sans-serif}
*{box-sizing:border-box}
table{border-collapse:collapse}
button{font-family:inherit}

/* Windows HTA native resize is used. No client-area resize overlay is placed over the window edges. */
#root{width:100%;height:100%;min-width:720px;min-height:520px}
.side{width:285px;background:#071322;border-right:1px solid #1d3047;vertical-align:top;padding:18px 14px}
.main{vertical-align:top;padding:22px 24px 10px;background:#071426}
.brand{height:76px;white-space:nowrap}.brand img{width:68px;height:68px;object-fit:contain;vertical-align:middle;margin-right:8px}.brandText{display:inline-block;vertical-align:middle}.brandName{font-size:23px;font-weight:bold;color:#fff}.brandName span{color:#2f8cff}.brandSub{font-size:11px;color:#a9bdd4;margin-top:4px}
.nav{width:100%;height:46px;margin-bottom:7px;border:1px solid #1c3249;background:#0b1e32;color:#d6e3f1;text-align:left;padding:0 12px;font-size:14px}.nav.active{background:#165dcc;border-color:#2d86ff;color:#fff}.ico{display:inline-block;width:28px;text-align:center;font-size:16px}
.sys{margin-top:24px;border:1px solid #29425d;background:#0d2035;padding:14px;height:190px}.sys h3{margin:0 0 12px;color:#fff;font-size:16px}.sys p{margin:8px 0;color:#b6c9dd;font-size:12px}.ver{color:#72869d;font-size:10px;line-height:1.6;margin-top:10px}
.top{height:62px;position:relative}.title{font-size:27px;color:#fff;font-weight:bold}.sub{font-size:13px;color:#8fa8c4;margin-top:5px}.admin{position:absolute;right:0;top:0;height:42px;padding:0 17px;border:1px solid #2b7be4;background:#0b1d31;color:#e2efff;font-weight:bold;font-size:13px}
.cards{width:100%;height:98px;table-layout:fixed}.cards td{padding:0 5px}.card{height:97px;border:1px solid #263d55;background:#12263d;padding:12px 15px;vertical-align:middle}.ready{background:#1450a6;border-color:#1e70e8}.lbl{font-size:12px;color:#9fb4ca}.big{font-size:25px;font-weight:bold;color:#fff;margin-top:5px}.small{font-size:11px;color:#a8bad0;margin-top:3px}.ok .lbl,.ok .small{color:#53df93}.warn .lbl{color:#ffc44b}.err .lbl{color:#ff707b}.fix .lbl{color:#5da8ff}
.content{height:auto;min-height:0;margin-top:16px}.left{width:auto;vertical-align:top;padding-right:8px}.right{width:316px;vertical-align:top;padding-left:8px}.panel{height:auto;min-height:100%;border:1px solid #23384f;background:#0b1b2c;overflow:visible;position:relative}.pt{height:47px;padding:14px 19px;font-size:16px;font-weight:bold;color:#fff;border-bottom:1px solid #1e3349}
.prog{height:78px;padding:13px 19px;border-bottom:1px solid #1e3349}.track{display:inline-block;width:64%;height:14px;vertical-align:middle;background:#06101c;border:1px solid #1b2c40;overflow:hidden}.bar{display:block;height:100%;width:0;background:#19e67a}.pct{display:inline-block;width:46px;text-align:right;font-weight:bold;font-size:12px}.btn{height:38px;border:1px solid #2a78e8;background:#1763d5;color:#fff;padding:0 15px;font-weight:bold;margin-left:8px}.stop{background:#0d1c2d;border-color:#38536d}.meta{margin-top:10px;color:#8198b2;font-size:10px}.meta span{margin-right:22px}
.selectTools{height:38px;padding:0 19px;display:flex;align-items:center;gap:7px;border-bottom:1px solid #1e3349}.selectBtn{height:30px;border:1px solid #2a78e8;background:#1763d5;color:#fff;padding:0 11px;font-weight:bold;font-size:11px}.selectBtn.recover{background:#d66a08;border-color:#f18a1b}.selectBtn.gray{background:#0d1c2d;border-color:#38536d}.selectCount{color:#8fa8c4;font-size:10px;margin-left:5px}.diagWrap{height:430px;min-height:430px;overflow-y:hidden;overflow-x:hidden;margin:0 19px 16px}
.diagWrap .diag{width:100%;margin:0}.dt{height:34px;padding:11px 19px 7px;color:#dbe8f7;font-size:13px}.diag{width:calc(100% - 38px);margin:0 19px;table-layout:fixed;border:1px solid #23394f}.diag th{height:31px;background:#122a42;color:#c2d3e6;font-size:13px;border-right:1px solid #29415a}.diag td{height:34px;border-top:1px solid #1b3045;color:#c8d7e7;font-size:13px;padding:0 8px;white-space:nowrap;overflow:visible}.sel{width:42px;text-align:center}.sel input{width:15px;height:15px;vertical-align:middle;accent-color:#1766d7}.n{width:45px;text-align:center}.it{width:210px;font-weight:bold;color:#e4eef9}.desc{color:#8ea5bd}.st{width:92px;text-align:center}.res{width:135px;text-align:center}.good{color:#48dc8a!important}.caution{color:#ffc44b!important}.bad{color:#ff6b77!important}
.log{position:relative;left:auto;right:auto;bottom:auto;height:150px;margin:0 19px 18px;border:1px solid #304861;background:#050d17;padding:8px;overflow:auto;font-family:Consolas,"Malgun Gothic",monospace;font-size:12px;color:#c9d8e8}.log div{margin-bottom:4px}
.statusPanel{height:100%;padding:0 13px}.srow{min-height:76px;border-bottom:1px solid #20364d;padding:10px 8px}.srow.netrow{min-height:78px}.slabel{font-size:11px;color:#9eb2c7}.sline{display:flex;align-items:center;margin-top:3px}.sicon{display:inline-block;width:30px;text-align:center;font-size:22px;line-height:28px;color:#dbe8f7;margin-right:7px}.sbody{flex:1;min-width:0}.svalue{font-size:19px;color:#fff;font-weight:bold;line-height:23px}.ssub{font-size:10px;color:#7f97b0;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meter{height:6px;background:#182b3f;border-radius:5px;margin-top:5px;overflow:hidden}.meterFill{display:block;height:100%;width:0;background:#16c965;border-radius:5px;transition:width .35s}.bsMainProgress{display:none;margin-top:8px}.bsMainProgress .bsMainTrack{display:inline-block;width:calc(100% - 48px);height:7px;background:#183149;border-radius:6px;overflow:hidden;vertical-align:middle}.bsMainProgress .bsMainBar{display:block;height:100%;width:0;background:#16c965;border-radius:6px;transition:width .35s}.bsMainProgress .bsMainPct{display:inline-block;width:40px;text-align:right;color:#48dc8a;font-size:11px;font-weight:bold;vertical-align:middle}.statusGood{color:#24d66d!important}.statusWarn{color:#ffc44b!important}.statusBad{color:#ff6675!important}.quick{margin-top:14px}.quick h3{font-size:15px;color:#fff;margin:0 0 9px}.q{width:49%;height:48px;margin:0 1% 8px 0;border:1px solid #245ea9;background:#124b9a;color:#fff;font-weight:bold;font-size:12px}.qg{background:#0d6f4b;border-color:#16885d}.qr{background:#8d2533;border-color:#b83a4b}.qp{width:100%;background:#f08a24;border-color:#ffad58}
.bottom{height:38px;border-top:1px solid #1d3249;margin-top:10px;color:#8fa5bc;font-size:10px;padding-top:12px;position:relative}.save{position:absolute;right:0;top:5px;height:34px;border:1px solid #304963;background:#0d1e31;color:#d7e5f5;padding:0 15px;font-weight:bold}

