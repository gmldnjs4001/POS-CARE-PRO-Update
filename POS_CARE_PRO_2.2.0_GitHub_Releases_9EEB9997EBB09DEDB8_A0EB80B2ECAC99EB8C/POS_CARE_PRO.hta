.loginLabel{display:block;color:#b8cbe0;font-size:12px;margin:10px 0 6px}.loginInput{width:100%;height:40px;border:1px solid #2a4560;background:#061321;color:#fff;padding:0 12px;font-size:14px;outline:none}.loginInput:focus{border-color:#2e83ee}
